    "3": {
      "name_cn": "三",
      "response": "我看到了三",
      "description": "食指、中指、无名指伸出"
    },
    "4": {
      "name_cn": "四",
      "response": "我看到了四",
      "description": "除拇指外四指伸出"
    },
    "5": {
      "name_cn": "五",
      "response": "我看到了五",
      "description": "五指全部伸出"
    },
    "Call_Me": {
      "name_cn": "打电话",
      "response": "要给你打电话吗？",
      "description": "拇指和小指伸出（打电话手势）"
